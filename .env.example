# Copy this file to .env.local (for local dev) and set the same variables in
# your Vercel project settings for deployment. See README.md for the full
# Neon + Vercel setup walkthrough.

# Postgres connection string from your Neon project (Dashboard -> Connection Details).
# Use the "pooled" connection string for serverless/Vercel deployments.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The passcode you'll type on the login screen. Pick anything memorable — this
# app has exactly one account (you), gated by this single shared passcode.
APP_PASSCODE="change-me"

# Random secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
APP_SESSION_SECRET="change-me-too"
